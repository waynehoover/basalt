{
  "name": "basalt-sync",
  "version": "0.2.0",
  "description": "Headless Obsidian vault sync for a Basalt server.",
  "keywords": [
    "obsidian",
    "sync",
    "self-hosted",
    "end-to-end-encryption",
    "notes"
  ],
  "homepage": "https://github.com/waynehoover/basalt-sync",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waynehoover/basalt-sync.git",
    "directory": "client"
  },
  "bugs": {
    "url": "https://github.com/waynehoover/basalt-sync/issues"
  },
  "license": "MIT",
  "author": "Wayne Hoover",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/basalt.mjs",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "bench": "bun run bench.ts",
    "bench:sync": "bun run bench-sync.ts",
    "build": "node esbuild.config.mjs production",
    "build:cli": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "format": "prettier --config ../.prettierrc --write \"src/**/*.ts\" \"*.ts\" \"*.mjs\"",
    "format:check": "prettier --config ../.prettierrc --check \"src/**/*.ts\" \"*.ts\" \"*.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "stress": "vitest run --config vitest.stress.config.ts"
  },
  "devDependencies": {
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^24.10.13",
    "diff-match-patch": "1.0.5",
    "esbuild": "^0.28.1",
    "fflate": "0.8.3",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "prettier": "^3.6.2"
  },
  "bin": {
    "basalt": "./dist/basalt.mjs"
  }
}
